{
  "name": "muslim-icons-explorer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && node scripts/generate-brand-assets.mjs && vite build && vite build --ssr src/prerender.tsx --outDir work/prerender && node scripts/prerender.mjs && node scripts/verify-discovery.mjs",
    "test": "vitest run",
    "assets": "node scripts/generate-brand-assets.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "fontkit": "^2.0.4",
    "jsdom": "^26.1.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": "22.x"
  }
}
